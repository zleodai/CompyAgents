--[=[
	Types

	Shared Luau type contracts for the server-side CompyAgent simulation. These
	types describe the data-first runtime, queue contracts, GOAP records,
	blackboard records, system dependencies, and swappable adapter interfaces.
]=]

-- AgentId uniquely identifies one simulated agent. Used by AgentStore,
-- blackboard records, perception contacts, queue jobs, and debug labels.
export type AgentId = string

-- TeamId identifies a team-level blackboard and team membership. Used by agents,
-- blackboards, configuration, and team lookups.
export type TeamId = string

-- QueueName identifies one scheduled work queue. Expected runtime keys are
-- "Perception", "Planning", "Pathing", and "Blackboard".
export type QueueName = string

-- QueueJobKind describes the broad category of a queued task. Used by BudgetQueue
-- stats/debugging and by system-created work items.
export type QueueJobKind = "Perception" | "Planning" | "Pathing" | "BlackboardCleanup"

-- MovementMode describes the current high-level movement state on an agent.
-- Movement adapters write this field and systems read it for debugging.
export type MovementMode = "Idle" | "Moving"

-- MovementStatus is returned by movement adapters after stepping an agent.
-- MovementSystem uses this to update AgentMovement data without reading GOAP.
export type MovementStatus = "Idle" | "Moving" | "Reached"

-- PathStatus describes whether a path provider produced usable waypoints.
-- Movement adapters consume this status before following the path.
export type PathStatus = "Success" | "Failed"

-- ActionId names the initial symbolic action catalogue. Used by GOAP plans,
-- action destination resolution, and debug labels.
export type ActionId = "TakeCover" | "AdvanceToEnemy" | "AttackVisibleEnemy" | "SearchLastKnown" | "Retreat" | "HoldPosition"

-- GoalId names the initial goal catalogue generated by Goals.luau. Used by
-- PlanExecutor and visualization/debug output.
export type GoalId = "Survive" | "PressureVisibleEnemy" | "SearchEnemyPosition" | "Hold"

-- FactMap stores symbolic GOAP facts. Current facts are boolean predicates.
-- Used by Goals, Planner, and action preconditions/effects.
export type FactMap = { [string]: boolean }

-- GOAPActionContext is passed to action lifecycle functions. PlanExecutor builds
-- this once per action tick and action modules use it for time-based checks.
export type GOAPActionContext = {
	dt: number,
	now: number,
}

-- GOAPAction is an executable action definition. Planner reads
-- preconditions/effects, while PlanExecutor calls the lifecycle methods with an
-- agent-specific AgentController.
export type GOAPAction = {
	id: ActionId,
	cost: number,
	preconditions: FactMap,
	effects: FactMap,
	duration: number?,
	checkAction: (AgentController, GOAPActionContext) -> boolean,
	onActionStart: (AgentController, GOAPActionContext) -> (),
	onActionUpdate: (AgentController, GOAPActionContext) -> (),
	onActionEnd: (AgentController, GOAPActionContext) -> (),
}

-- GOAPPlan is the ordered action sequence assigned to an agent. Stored in
-- Agent.decision.currentPlan and advanced by PlanExecutor.
export type GOAPPlan = { GOAPAction }

-- GOAPGoal is a candidate symbolic objective. Goals.luau creates these and the
-- planner tests plans against the goal facts.
export type GOAPGoal = {
	id: GoalId,
	priority: number,
	facts: FactMap,
}

-- PlannerOptions controls bounded GOAP search. Config.GOAP provides these
-- values and Planner.Plan consumes them.
export type PlannerOptions = {
	MaxExpansions: number,
	MaxPlanDepth: number,
	ReplanCooldown: number,
	FailedPlanCooldown: number,
}

-- PlannerNode is an internal search node used by Planner.Plan.
export type PlannerNode = {
	facts: FactMap,
	plan: GOAPPlan,
	cost: number,
}

-- PlanResult is returned by Planner.Plan and passed into PlanExecutor.AssignPlan.
export type PlanResult = {
	success: boolean,
	actions: GOAPPlan?,
	cost: number?,
	expansions: number,
	reason: string?,
}

-- PathResult is the common path-provider output. Grid and Roblox pathing adapters
-- both return this structure so movement code can stay adapter-neutral.
export type PathResult = {
	status: PathStatus,
	waypoints: { Vector3 },
	reason: string?,
}

-- PerceptionContact is a currently visible or recently seen enemy. Sensors write
-- contacts into agent perception and team blackboards.
export type PerceptionContact = {
	agentId: AgentId,
	teamId: TeamId,
	position: Vector3,
	confidence: number,
	lastSeenAt: number,
}

-- PerceptionResult is the sensor output consumed by PerceptionSystem.
export type PerceptionResult = {
	visibleEnemies: { PerceptionContact },
	lastSeenEnemies: { [AgentId]: PerceptionContact },
}

-- EnemySighting is a blackboard persistence record created from perception
-- contacts and expired by BlackboardStore.Cleanup.
export type EnemySighting = {
	agentId: AgentId,
	teamId: TeamId,
	position: Vector3,
	confidence: number,
	lastSeenAt: number,
	expiresAt: number,
}

-- ReservationRecord claims a team-local resource such as cover, route, or future
-- tactical slots. Used by BlackboardStore and Reservations helpers.
export type ReservationRecord = {
	resourceId: string,
	ownerId: AgentId,
	createdAt: number,
	expiresAt: number,
}

-- IntentDraft is the caller-provided role intent before BlackboardStore stamps
-- owner and expiration metadata onto it.
export type IntentDraft = {
	role: string?,
	target: string?,
	ownerId: AgentId?,
	createdAt: number?,
	expiresAt: number?,
}

-- IntentRecord describes one short-lived tactical claim. Used by Intents helpers
-- and blackboard coordination logic.
export type IntentRecord = {
	ownerId: AgentId,
	role: string?,
	target: string?,
	createdAt: number,
	expiresAt: number,
}

-- DangerZoneRecord is reserved for grenade/blast/firing danger claims. It is
-- stored in BlackboardStore.dangerZones for future coordination checks.
export type DangerZoneRecord = {
	ownerId: AgentId,
	center: Vector3,
	radius: number,
	createdAt: number,
	expiresAt: number,
}

-- BlackboardStore is the team-local shared memory object. Agents and systems use
-- this for sightings, reservations, intents, and cleanup.
export type BlackboardStore = {
	teamId: TeamId,
	enemySightings: { [AgentId]: EnemySighting },
	reservations: { [string]: ReservationRecord },
	intents: { [AgentId]: IntentRecord },
	dangerZones: { [number]: DangerZoneRecord },
	RecordEnemySighting: (BlackboardStore, PerceptionContact, number) -> (),
	GetBestEnemySighting: (BlackboardStore) -> EnemySighting?,
	Reserve: (BlackboardStore, string, AgentId, number, number) -> boolean,
	PublishIntent: (BlackboardStore, AgentId, IntentDraft, number, number) -> (),
	Cleanup: (BlackboardStore, number) -> (),
}

-- AgentTransform stores the simulated transform used by movement, perception,
-- combat, pathing, and visualization.
export type AgentTransform = {
	position: Vector3,
	facing: Vector3,
}

-- AgentStats stores combat-relevant state. CombatSystem mutates health/ammo and
-- AgentController.Kill flips alive to false.
export type AgentStats = {
	health: number,
	ammo: number,
	alive: boolean,
}

-- AgentDecision stores GOAP planning state. PlanningSystem and PlanExecutor
-- mutate these fields.
-- actionRuntime is per-agent execution state for the currently active action;
-- action module definitions remain immutable and shared.
export type AgentActionRuntime = {
	actionId: ActionId?,
	started: boolean,
	startedAt: number,
}

export type AgentDecision = {
	currentGoal: GoalId?,
	currentPlan: GOAPPlan?,
	currentActionIndex: number,
	needsPlan: boolean,
	planningQueued: boolean,
	nextThinkAt: number,
	lastPlanReason: string?,
	actionRuntime: AgentActionRuntime,
}

-- AgentMovement stores path request/following state. PathSystem and movement
-- adapters read and write these fields. Action modules request movement through
-- AgentController; MovementSystem only reacts to this data.
export type AgentMovement = {
	mode: MovementMode,
	destination: Vector3?,
	path: PathResult?,
	pathIndex: number,
	needsPath: boolean,
	pathQueued: boolean,
	nextPathAt: number,
	arrived: boolean,
}

-- AgentCombat stores intent for abstract combat. Action modules request shots
-- through AgentController; CombatSystem consumes this data and records results.
export type AgentCombat = {
	targetId: AgentId?,
	shouldFire: boolean,
	shotCompleted: boolean,
	lastShotAt: number,
	lastShotOrigin: Vector3?,
	lastShotTarget: Vector3?,
}

-- AgentPerception stores visible and remembered enemies. PerceptionSystem writes
-- this data and Goals/CombatSystem consume it.
export type AgentPerception = {
	visibleEnemies: { PerceptionContact },
	lastSeenEnemies: { [AgentId]: PerceptionContact },
	nextSenseAt: number,
	sensingQueued: boolean,
}

-- AgentTactical stores derived tactical flags used by goals and movement
-- completion logic.
export type AgentTactical = {
	inCover: boolean,
	suppressed: boolean,
}

-- Agent is the full data-first simulation record. It is stored in AgentStore and
-- is the primary data object passed through systems and adapters.
export type Agent = {
	id: AgentId,
	teamId: TeamId,
	transform: AgentTransform,
	stats: AgentStats,
	decision: AgentDecision,
	movement: AgentMovement,
	combat: AgentCombat,
	perception: AgentPerception,
	tactical: AgentTactical,
}

-- AgentStore stores agents by id, ordered list, and team. Systems use this
-- instead of scanning Roblox Instances.
export type AgentStore = {
	byId: { [AgentId]: Agent },
	ordered: { Agent },
	byTeam: { [TeamId]: { Agent } },
	Add: (AgentStore, Agent) -> boolean,
	Get: (AgentStore, AgentId) -> Agent?,
	GetAll: (AgentStore) -> { Agent },
	GetTeam: (AgentStore, TeamId) -> { Agent },
	ForEachAlive: (AgentStore, (Agent) -> ()) -> (),
}

-- AgentControllerDependencies are the shared services needed by a per-agent
-- AgentController. PlanExecutor creates controllers for action modules, and
-- CombatSystem may create one when resolving death cleanup.
export type AgentControllerDependencies = {
	config: Config,
	agentStore: AgentStore,
	blackboard: BlackboardStore,
	worldQuery: WorldQueryAdapter,
}

-- AgentController is the per-agent behavior surface passed into action modules.
-- It owns behavior requests such as movement, cover, shooting, and plan resets
-- while holding a direct reference to the agentState data record.
export type AgentController = {
	agentState: Agent,
	config: Config,
	agentStore: AgentStore,
	blackboard: BlackboardStore,
	worldQuery: WorldQueryAdapter,
	RequestPlan: (AgentController, number?, string?) -> (),
	ClearPlan: (AgentController) -> (),
	Kill: (AgentController) -> (),
	MoveTo: (AgentController, Vector3) -> (),
	MoveForAction: (AgentController, ActionId) -> (),
	TakeCoverAt: (AgentController, Vector3) -> (),
	LookAtPosition: (AgentController, Vector3, number) -> (),
	ShootAtTarget: (AgentController, AgentId) -> (),
	StopShooting: (AgentController) -> (),
	SetInCover: (AgentController, boolean) -> (),
	GetBestVisibleEnemy: (AgentController) -> PerceptionContact?,
	GetBestKnownEnemyPosition: (AgentController) -> Vector3?,
	HasReachedDestination: (AgentController) -> boolean,
	HasCompletedShot: (AgentController) -> boolean,
	GetActionElapsed: (AgentController, number) -> number,
}

-- AgentControllerModule is the constructor/static table returned by
-- Agents.AgentController.
export type AgentControllerModule = {
	new: (Agent, AgentControllerDependencies) -> AgentController,
}

-- QueueOptions configures one BudgetQueue. Config.Queues provides this data.
export type QueueOptions = {
	MaxJobsPerFrame: number,
	MaxMsPerFrame: number,
}

-- QueueStats stores the most recent processing result from a BudgetQueue.
export type QueueStats = {
	lastProcessed: number,
	lastCompleted: number,
	lastErrors: number,
	lastRemaining: number,
}

-- SimulationContext is passed to scheduled callbacks and queued jobs. It
-- contains frame delta and simulation time.
export type SimulationContext = {
	dt: number,
	now: number,
}

-- QueueJob is the unit of deferred work processed by BudgetQueue. Planning,
-- pathing, perception, and blackboard systems enqueue this shape.
export type QueueJob = {
	id: string?,
	kind: QueueJobKind?,
	priority: number?,
	agentId: AgentId?,
	run: (SimulationContext) -> boolean,
}

-- BudgetQueue is the bounded per-frame queue object. Simulation owns one queue
-- per major expensive process.
export type BudgetQueue = {
	name: QueueName,
	items: { QueueJob },
	inQueue: { [string]: boolean },
	maxJobsPerFrame: number,
	maxMsPerFrame: number,
	stats: QueueStats,
	Enqueue: (BudgetQueue, QueueJob) -> boolean,
	Length: (BudgetQueue) -> number,
	Process: (BudgetQueue, SimulationContext) -> QueueStats,
}

-- BudgetQueueModule is the constructor/static table returned by
-- Core.BudgetQueue.
export type BudgetQueueModule = {
	new: (string, QueueOptions) -> BudgetQueue,
}

-- QueuesByName is Simulation.queues. It is a dictionary keyed by queue name; the
-- current keys are Perception, Planning, Pathing, and Blackboard.
export type QueuesByName = { [QueueName]: BudgetQueue }

-- ScheduledInterval stores one fixed-cadence callback registered in Scheduler.
export type ScheduledInterval = {
	interval: number,
	callback: (SimulationContext) -> (),
	elapsed: number,
}

-- Scheduler coordinates fixed-cadence scans plus per-frame queue processing.
-- Simulation owns one Scheduler instance.
export type Scheduler = {
	queues: QueuesByName,
	queueOrder: { QueueName },
	intervals: { [string]: ScheduledInterval },
	RegisterQueue: (Scheduler, QueueName, BudgetQueue) -> (),
	GetQueue: (Scheduler, QueueName) -> BudgetQueue?,
	Every: (Scheduler, string, number, (SimulationContext) -> (), boolean?) -> (),
	Step: (Scheduler, SimulationContext) -> (),
}

-- SchedulerModule is the constructor/static table returned by Core.Scheduler.
export type SchedulerModule = {
	new: () -> Scheduler,
}

-- DebugConfig controls debug visualization behavior.
export type DebugConfig = {
	Enabled: boolean,
	ShowAgentLabels: boolean,
}

-- TestConfig controls server startup test mode. When Enabled is true,
-- Main.server runs Tests.TestRunner instead of starting Simulation.
export type TestConfig = {
	Enabled: boolean,
	Verbose: boolean,
	FailFast: boolean,
}

-- TestValue is the primitive comparison domain used by the lightweight Roblox
-- test harness assertion helpers.
export type TestValue = string | number | boolean | nil

-- TestContext is passed into every test case. It contains typed assertion
-- helpers so tests avoid untyped ad hoc checks.
export type TestContext = {
	Assert: (boolean, string) -> (),
	AssertEqual: (TestValue, TestValue, string) -> (),
	AssertActionSequence: ({ ActionId }, { ActionId }, string) -> (),
}

-- TestCase is one executable server-side test. Tests.TestRunner runs these
-- cases when Config.Tests.Enabled is true.
export type TestCase = {
	name: string,
	run: (TestContext) -> (),
}

-- TestFailure stores one failed test name and message for the final test
-- summary printed by Tests.TestRunner.
export type TestFailure = {
	name: string,
	message: string,
}

-- TestSummary is the aggregate result returned by Tests.TestRunner.RunAll.
export type TestSummary = {
	total: number,
	passed: number,
	failed: number,
	failures: { TestFailure },
}

-- AgentBootstrapConfig controls automatic demo agent creation during startup.
export type AgentBootstrapConfig = {
	Enabled: boolean,
	DemoAgentsPerTeam: number,
	TargetAgentsPerTeam: number,
}

-- LevelConfig controls Studio-authored level discovery. When enabled,
-- Simulation can use tagged Studio parts for startup spawns while preserving
-- config-authored spawn origins as a fallback.
export type LevelConfig = {
	UseStudioLevel: boolean,
	UseConfigSpawnsFallback: boolean,
	SpawnTag: string,
	CoverTag: string,
	ObjectiveTag: string,
}

-- CadenceConfig controls scan/update intervals for systems and visualization.
export type CadenceConfig = {
	PlanningScanInterval: number,
	PathingScanInterval: number,
	PerceptionInterval: number,
	BlackboardCleanupInterval: number,
	VisualizationInterval: number,
	CombatInterval: number,
}

-- QueuesConfig groups per-queue BudgetQueue settings.
export type QueuesConfig = {
	Planning: QueueOptions,
	Pathing: QueueOptions,
	Perception: QueueOptions,
	Blackboard: QueueOptions,
}

-- GridConfig controls the prototype grid dimensions and scale.
export type GridConfig = {
	Width: number,
	Height: number,
	CellSize: number,
	Origin: Vector3,
}

-- SensorConfig controls perception range and future field-of-view logic.
export type SensorConfig = {
	Range: number,
	FieldOfViewDegrees: number,
}

-- MovementConfig controls waypoint following speed, completion tolerance, and
-- maximum data-facing turn rate for movement and action aiming.
export type MovementConfig = {
	Speed: number,
	WaypointTolerance: number,
	FacingTurnRateRadiansPerSecond: number,
}

-- PathingConfig controls path request throttling.
export type PathingConfig = {
	RepathCooldown: number,
}

-- CombatConfig controls the abstract combat cadence effects.
export type CombatConfig = {
	Range: number,
	DamagePerTick: number,
	RequiredAimDot: number,
}

-- VisualizationConfig controls the read-only Roblox Instance visualization.
export type VisualizationConfig = {
	FolderName: string,
	AgentSize: Vector3,
	VerticalOffset: Vector3,
	LerpAlpha: number,
	DestinationMarkerSize: Vector3,
	DestinationMarkerOffset: Vector3,
	DestinationLineThickness: number,
	DestinationLineColor: Color3,
	DestinationLineTransparency: number,
	ShootingLineThickness: number,
	ShootingLineLength: number,
	ShootingLineColor: Color3,
	ShootingLineTransparency: number,
	ShotFlashDuration: number,
	FacingArrowOffset: Vector3,
	FacingArrowLength: number,
	FacingArrowShaftThickness: number,
	FacingArrowColor: Color3,
	FacingArrowTransparency: number,
}

-- TeamConfig controls team color and demo spawn layout.
export type TeamConfig = {
	Color: Color3,
	SpawnOrigin: Vector3,
	SpawnSpacing: number,
	Forward: Vector3,
}

-- TeamsConfig stores all team configurations by TeamId.
export type TeamsConfig = { [TeamId]: TeamConfig }

-- StudioSpawnPoint is a typed record generated from a tagged Studio spawn part.
export type StudioSpawnPoint = {
	part: BasePart,
	teamId: TeamId?,
	squadId: string?,
	spawnOrder: number,
	spawnRadius: number,
	cframe: CFrame,
	position: Vector3,
	facing: Vector3,
}

-- StudioCoverPoint is a typed record generated from a tagged Studio cover part.
export type StudioCoverPoint = {
	part: BasePart,
	coverId: string,
	coverQuality: number,
	teamId: TeamId?,
	cframe: CFrame,
	position: Vector3,
	facing: Vector3,
}

-- StudioObjective is a typed record generated from a tagged Studio objective
-- part.
export type StudioObjective = {
	part: BasePart,
	objectiveId: string,
	teamId: TeamId?,
	radius: number,
	cframe: CFrame,
	position: Vector3,
}

-- StudioWorldRegistry is the startup snapshot of tagged Studio-authored level
-- objects. Query methods return fresh arrays so callers do not mutate registry
-- list membership.
export type StudioWorldRegistry = {
	config: Config,
	spawnPoints: { StudioSpawnPoint },
	coverPoints: { StudioCoverPoint },
	objectives: { StudioObjective },
	Refresh: (StudioWorldRegistry) -> (),
	GetSpawnPoints: (StudioWorldRegistry, TeamId?) -> { StudioSpawnPoint },
	GetCoverPoints: (StudioWorldRegistry, TeamId?) -> { StudioCoverPoint },
	GetObjectives: (StudioWorldRegistry, TeamId?) -> { StudioObjective },
}

-- Config is the full central configuration table returned by Core.Config.
export type Config = {
	SimulationMode: "Grid" | "Spatial",
	Debug: DebugConfig,
	Tests: TestConfig,
	AgentBootstrap: AgentBootstrapConfig,
	Level: LevelConfig,
	Cadence: CadenceConfig,
	Queues: QueuesConfig,
	GOAP: PlannerOptions,
	Grid: GridConfig,
	Sensor: SensorConfig,
	Movement: MovementConfig,
	Pathing: PathingConfig,
	Combat: CombatConfig,
	Visualization: VisualizationConfig,
	Teams: TeamsConfig,
}

-- WorldQueryAdapter is the swappable world-query interface used by sensors,
-- pathing, and movement destination resolution.
export type WorldQueryAdapter = {
	ClampToWorld: (WorldQueryAdapter, Vector3) -> Vector3,
	HasLineOfSight: (WorldQueryAdapter, Vector3, Vector3) -> boolean,
	ResolveActionDestination: (WorldQueryAdapter, Agent, ActionId, BlackboardStore) -> Vector3,
}

-- GridWorldQueryAdapter is the concrete world-query provider for grid mode.
export type GridWorldQueryAdapter = WorldQueryAdapter & {
	config: Config,
}

-- SpatialWorldQueryAdapter is the concrete world-query provider for 3D mode.
export type SpatialWorldQueryAdapter = WorldQueryAdapter & {
	config: Config,
}

-- SensorAdapter is the swappable perception interface. GridSensor and
-- RaycastSensor implement this contract.
export type SensorAdapter = {
	Sense: (SensorAdapter, Agent, WorldQueryAdapter, AgentStore, BlackboardStore, number) -> PerceptionResult,
}

-- GridSensorAdapter is the concrete grid sensor instance created by GridSensor.
export type GridSensorAdapter = SensorAdapter & {
	config: Config,
}

-- RaycastSensorAdapter is the concrete raycast sensor instance created by
-- RaycastSensor.
export type RaycastSensorAdapter = SensorAdapter & {
	config: Config,
}

-- MovementDriver is the swappable movement interface. GridMovement and
-- PathfindingMovement implement this contract.
export type MovementDriver = {
	SetPath: (MovementDriver, Agent, PathResult) -> (),
	Step: (MovementDriver, Agent, number) -> MovementStatus,
}

-- GridMovementDriver is the concrete grid waypoint follower.
export type GridMovementDriver = MovementDriver & {
	config: Config,
}

-- PathfindingMovementDriver is the concrete 3D movement shell that currently
-- delegates waypoint following to GridMovement.
export type PathfindingMovementDriver = MovementDriver & {
	gridDriver: GridMovementDriver,
}

-- PathProvider is the swappable pathing interface. GridPathfinder and
-- RobloxPathfinder implement this contract.
export type PathProvider = {
	FindPath: (PathProvider, Agent, Vector3, WorldQueryAdapter?, number?) -> PathResult,
}

-- GridPathfinderProvider is the concrete path provider used by grid mode.
export type GridPathfinderProvider = PathProvider & {
	config: Config,
}

-- RobloxPathfinderProvider is the concrete path provider backed by Roblox
-- PathfindingService.
export type RobloxPathfinderProvider = PathProvider & {
	config: Config,
}

-- Adapters is the concrete adapter bundle selected by Simulation.createAdapters.
export type Adapters = {
	sensor: SensorAdapter,
	movementDriver: MovementDriver,
	pathProvider: PathProvider,
	worldQuery: WorldQueryAdapter,
}

-- SystemDependencies is the dependency bag passed into every system constructor.
export type SystemDependencies = {
	config: Config,
	agentStore: AgentStore,
	blackboards: { [TeamId]: BlackboardStore },
	adapters: Adapters,
	queues: QueuesByName,
}

-- PerceptionSystem scans agents and enqueues sensor jobs.
export type PerceptionSystem = {
	agentStore: AgentStore,
	blackboards: { [TeamId]: BlackboardStore },
	sensor: SensorAdapter,
	worldQuery: WorldQueryAdapter,
	queue: BudgetQueue,
	interval: number,
	Scan: (PerceptionSystem, number) -> (),
}

-- PerceptionSystemModule is the constructor/static table returned by
-- Systems.PerceptionSystem.
export type PerceptionSystemModule = {
	new: (SystemDependencies) -> PerceptionSystem,
}

-- PlanningSystem scans agents that need GOAP plans and enqueues planner jobs.
export type PlanningSystem = {
	config: Config,
	agentStore: AgentStore,
	blackboards: { [TeamId]: BlackboardStore },
	queue: BudgetQueue,
	Scan: (PlanningSystem, number) -> (),
}

-- PlanningSystemModule is the constructor/static table returned by
-- Systems.PlanningSystem.
export type PlanningSystemModule = {
	new: (SystemDependencies) -> PlanningSystem,
}

-- PathSystem scans agents that need paths and enqueues path provider jobs.
export type PathSystem = {
	config: Config,
	agentStore: AgentStore,
	worldQuery: WorldQueryAdapter,
	pathProvider: PathProvider,
	movementDriver: MovementDriver,
	queue: BudgetQueue,
	Scan: (PathSystem, number) -> (),
}

-- PathSystemModule is the constructor/static table returned by Systems.PathSystem.
export type PathSystemModule = {
	new: (SystemDependencies) -> PathSystem,
}

-- CombatSystem resolves abstract combat at a fixed cadence by consuming
-- AgentCombat requests. It does not inspect or advance GOAP actions.
export type CombatSystem = {
	config: Config,
	agentStore: AgentStore,
	blackboards: { [TeamId]: BlackboardStore },
	worldQuery: WorldQueryAdapter,
	accumulator: number,
	Step: (CombatSystem, number, number) -> (),
}

-- CombatSystemModule is the constructor/static table returned by
-- Systems.CombatSystem.
export type CombatSystemModule = {
	new: (SystemDependencies) -> CombatSystem,
}

-- BlackboardSystem queues team blackboard cleanup jobs.
export type BlackboardSystem = {
	blackboards: { [TeamId]: BlackboardStore },
	queue: BudgetQueue,
	EnqueueCleanup: (BlackboardSystem, number) -> (),
}

-- BlackboardSystemModule is the constructor/static table returned by
-- Systems.BlackboardSystem.
export type BlackboardSystemModule = {
	new: (SystemDependencies) -> BlackboardSystem,
}

-- MovementSystem advances AgentMovement requests through MovementDriver. It does
-- not inspect GOAP actions; PlanExecutor checks completion from AgentMovement.
export type MovementSystem = {
	agentStore: AgentStore,
	movementDriver: MovementDriver,
	Step: (MovementSystem, number, number) -> (),
}

-- MovementSystemModule is the constructor/static table returned by
-- Systems.MovementSystem.
export type MovementSystemModule = {
	new: (SystemDependencies) -> MovementSystem,
}

-- VisualizationSystem polls simulation data and updates Roblox Parts.
export type VisualizationSystem = {
	config: Config,
	agentStore: AgentStore,
	parts: { [AgentId]: BasePart },
	destinationMarkers: { [AgentId]: BasePart },
	destinationLines: { [AgentId]: BasePart },
	shootingLines: { [AgentId]: BasePart },
	facingArrowShafts: { [AgentId]: BasePart },
	labels: { [AgentId]: TextLabel },
	accumulator: number,
	folder: Folder?,
	Initialize: (VisualizationSystem) -> (),
	_ensureAgentPart: (VisualizationSystem, Agent) -> BasePart,
	_ensureDestinationMarker: (VisualizationSystem, Agent) -> BasePart,
	_ensureDestinationLine: (VisualizationSystem, Agent) -> BasePart,
	_ensureShootingLine: (VisualizationSystem, Agent) -> BasePart,
	_ensureFacingArrowShaft: (VisualizationSystem, Agent) -> BasePart,
	Step: (VisualizationSystem, number, number) -> (),
}

-- VisualizationSystemModule is the constructor/static table returned by
-- Systems.VisualizationSystem.
export type VisualizationSystemModule = {
	new: (SystemDependencies) -> VisualizationSystem,
}

-- SimulationSystems is Simulation.systems. It contains each concrete system
-- instance keyed by its role in the update loop.
export type SimulationSystems = {
	perception: PerceptionSystem,
	planning: PlanningSystem,
	pathing: PathSystem,
	combat: CombatSystem,
	blackboard: BlackboardSystem,
	movement: MovementSystem,
	visualization: VisualizationSystem,
}

-- Simulation is the top-level runtime object created by Core.Simulation.new.
export type Simulation = {
	config: Config,
	now: number,
	started: boolean,
	agentStore: AgentStore,
	blackboards: { [TeamId]: BlackboardStore },
	adapters: Adapters,
	studioWorldRegistry: StudioWorldRegistry,
	scheduler: Scheduler,
	queues: QueuesByName,
	systemDependencies: SystemDependencies,
	systems: SimulationSystems,
	_registerCadence: (Simulation) -> (),
	_spawnDemoAgents: (Simulation, number) -> (),
	_spawnDemoAgentsFromStudio: (Simulation, number) -> boolean,
	Start: (Simulation) -> (),
	Step: (Simulation, number) -> (),
}

return {}
