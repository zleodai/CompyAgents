{
    "files.associations": {
        "*.luau": "luau",
    },
    "Lua.diagnostics.globals": [
        "game",
        "script",
        "Enum"
    ],
    "luau-lsp.studioPlugin.enabled": true,
    "luau-lsp.hover.useTypeAliasesInCyclicTypes": true,
    "luau-lsp.hover.typeExpansionDepth": 1,
    "luau-lsp.hover.tablePropertyLimit": 1000,
    "luau-lsp.hover.lineLimit": 1000,
    "luau-lsp.hover.expandClassTypes": false
}
